<div class="bg-white rounded-lg shadow overflow-hidden mb-12">
  <table class="w-full">
    <!-- New Work Experience -->
    <div class="mb-6 m-6 flex items-center">

      <a href="/dashboard/experiences" class="ml-auto">
        <button
          class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-md border border-blue-600 transition-colors duration-200 flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
              clip-rule="evenodd"
            ></path>
          </svg>
          New Work Experience
        </button>
      </a>
    </div>

    <!-- Table Header -->
    <thead class="bg-gray-100">
      <tr>
        <th
          class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"
        >ID</th>
        <th
          class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"
        >Role</th>
        <th
          class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"
        >Company</th>
        <th
          class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"
        >Duration</th>
        <th
          class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"
        >Tech Stack</th>
        <th
          class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"
        >Action</th>
      </tr>
    </thead>

    <!-- Table Body -->
    <tbody class="bg-white divide-y divide-gray-200">
      {{#each experiences}}
        <tr class="hover:bg-gray-50 transition-colors duration-150">
          <td
            class="px-2 py-4 text-center whitespace-nowrap text-sm text-gray-900"
          >{{this.id}}</td>
          <td
            class="px-2 py-4 text-center whitespace-nowrap text-sm text-gray-900"
          >
            <div class="text-sm font-medium text-gray-900">{{this.role}}</div>
          </td>
          <td class="px-2 py-4 text-center whitespace-nowrap">
            <div class="flex justify-center items-center">
              <div
                class="inline-flex items-center justify-center p-4 rounded-2xl shadow-xs w-14 h-14 transition-all duration-300 hover:scale-105 hover:shadow-md"
              >
                <img
                  class="w-full h-full object-contain"
                  src="/assets/uploads/{{this.img}}"
                  alt="{{this.company}}"
                />
              </div>
              <div class="text-sm text-gray-900">{{this.company.name}}</div>
            </div>
          </td>
          <td
            class="px-2 py-4 text-center whitespace-nowrap text-sm text-gray-900"
          >
            <div>{{this.start}} - {{this.end}}</div>
            <div class="text-xs text-gray-500">{{this.duration}}</div>
          </td>
          <td class="px-2 py-4 text-center">
            <div class="flex flex-wrap gap-1 justify-center">
              {{#each this.techUsed}}
                <span
                  class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full"
                >{{this}}</span>
              {{/each}}
            </div>
          </td>
          <td class="px-2 py-4 text-center">
            <div class="flex justify-center items-center space-x-2">
              <a href="/dashboard/experiences/{{this.id}}/">
                <button
                  class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200"
                >
                  Edit
                </button>
              </a>
              <form onsubmit="return confirmDelete(event)" class="inline">
                <input type="hidden" name="id" value="{{this.id}}" />
                <button
                  class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200"
                  data-table="experiences"
                  data-name="{{this.role}} at {{this.company}}"
                >
                  Delete
                </button>
              </form>
            </div>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>