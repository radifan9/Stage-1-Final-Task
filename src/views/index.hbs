<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="/swiper/swiper-bundle.min.css"
    />
    <link
      rel="stylesheet"
      href="assets/css/dist/styles.css"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>Stage 1 - Final Task</title>
  </head>
  <body>
    <div class="flex flex-col">
      <!-- NAVBAR -->
      {{>navbar}}

      <main class="max-w-7xl px-4 mx-auto mt-24">
        <!-- HERO SECTION -->
        <div class="flex px-6 py-12 gap-12 mb-16">
          <!-- Left Content - Foto Profil -->
          <div class="lg:w-1/3">
            <img
              class="w-64 h-64 lg:w-[320px] lg:h-[320px] rounded-xl object-cover shadow-[0_0_1.0rem_0.1rem_#d8b4fe]"
              src="/assets/images/profile.jpg"
              alt="Foto Mas Surya"
            />
          </div>

          <!-- Right Content - Profil -->
          <div class="flex flex-col lg:w-2/3 gap-4">
            <h1>
              <span class="block text-6xl font-bold mb-6"
                >Hi, I'm Surya 👋</span
              >
              <span class="block text-2xl font-medium text-gray-600"
                >Indie Hacker &amp; Full-Stack Developer</span
              >
            </h1>

            <p class="text-gray-600">
              I build and ship digital products from scratch to production.
              Passionate about creating end-to-end solutions and turning ideas
              into fully functional applications. With expertise in both
              frontend and backend development, I handle everything from initial
              concept to deployment and maintenance.
            </p>
            <div class="flex items-center gap-1 text-gray-500">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"
                />
              </svg>
              <span>Depok, Sawangan, Indonesia</span>
            </div>
            <div class="flex items-center gap-2">
              <span
                class="inline-block w-2 h-2 bg-green-500 rounded-full"
              ></span>
              <span class="text-gray-500">Available for new projects</span>
            </div>
            <div>
              <ul class="flex gap-3">
                <li>
                  <a
                    class="bg-green-500 hover:bg-green-600 text-white px-5 py-3 rounded-lg flex items-center font-medium"
                    href="#"
                  >
                    <img
                      src="/assets/images/whatsapp.png"
                      alt="Logo Whatsapp"
                      class="w-4 h-4 mr-2"
                    />
                    Let's Talk
                  </a>
                </li>
                <li>
                  <a
                    class="flex bg-black text-white px-5 py-3 rounded-lg items-center"
                    href="#"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-4 h-4 mr-2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
                      />
                    </svg>
                    Download CV
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- TECH SLIDE -->
        <h2 class="text-2xl font-bold mb-12">
          Tech Stack - Tools I Use Everyday
        </h2>
        <div class="swiper mb-32">
          <div class="swiper-wrapper text-gray-600">
            {{#each techStacks}}
              <div class="swiper-slide">
                <div class="flex flex-col items-center">
                  <div
                    class="p-4 rounded-2xl shadow-xs mb-3 w-18 h-18 flex items-center justify-center transition-all duration-300 hover:scale-105 hover:shadow-md"
                  >
                    <img
                      class="w-full h-full"
                      src="/assets/uploads/{{this.img}}"
                      alt=""
                    />
                  </div>
                  <span class="text-justify">{{this.title}}</span>
                </div>
              </div>
            {{/each}}
          </div>
        </div>

        <!-- Work Experiences -->
        <h2 class="text-2xl font-bold mb-12">Work Experiences:</h2>
        <div id="workContainer" class="mb-32">
          {{#each experiences}}
            <div
              class="flex gap-9 p-6 rounded-xl shadow-xs justify-start items-start"
            >
              <div>
                <img class="w-14" src="./../assets/uploads/{{this.img}}" alt="Logo {{this.company.name}} company" />
              </div>
              <div class="flex flex-col gap-2">
                <h3 class="text-lg font-semibold">{{this.role}}</h3>
                <p class="-mt-3 text-green-600">{{this.company}}</p>
                <ul class="list-disc list-inside text-gray-600">
                  {{#each responsibilities}}
                    <li class="text-sm/7">{{this}}</li>
                  {{/each}}
                </ul>
                <ul class="flex gap-4 mt-2 text-gray-700 text-xs font-medium">
                  {{#each techUsed}}
                    <li class="bg-gray-200 px-3 py-1 rounded-full">{{this}}</li>
                  {{/each}}
                </ul>
              </div>
              <p class="ml-auto text-gray-500 text-sm">{{this.start}} - {{this.end}}</p>
            </div>
          {{/each}}
        </div>

        {{!-- PROJECTS --}}
        <h2 class="text-2xl font-bold mb-12">My Projects:</h2>
        <div class="grid grid-cols-2 gap-8 mb-32" id="projectContainer">
          {{#each projects}}
          <div class="flex flex-col gap-1 rounded-2xl shadow-xs hover:shadow-md overflow-hidden">
            <div class="h-52 bg-gray-100 overflow-hidden">
              <img
                class="h-full mx-auto"
                src="/assets/uploads/{{this.img}}"
                alt="Demo project {{this.title}}"
              />
            </div>

            <div class="flex flex-col gap-2 mx-9 mt-6 mb-7">
              {{!-- DESCRIPTION, ETC --}}

              <h3 class="text-xl font-semibold">{{this.title}}</h3>
              
              <p class="text-sm text-gray-600 mb-2">{{this.description}}</p>

              <ul class="flex gap-6 text-gray-600 font-medium text-xs mb-5">
                {{!-- TECH USED --}}
                {{#each techUsed}}
                  <li class="bg-gray-200 px-3 py-1 rounded-2xl">{{this}}</li>
                {{/each}}  
              </ul>
  
              <div class="flex gap-8 text-xs">
                {{!-- GITHUB REPO --}}
                {{#if this.githubRepo}}
                <a href="{{this.githubRepo}}"><div class="flex gap-1 text-blue-600 items-center ml-4">
                  <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.237 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
                </svg>
                  <span>View on GitHub</span>
                </div></a>
                {{else}}
                <div class="flex items-center gap-1 text-gray-600 ml-4">
                  <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.237 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
                </svg>
                  <span>Private Repository</span>
                </div>
                {{/if}}
                
                {{!-- LIVE DEMO --}}
                {{#if this.liveDemo}}
                <a href="{{this.liveDemo}}"><div class="flex gap-1 items-center text-blue-600">
                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                  <span>Live Demo</span>
                </div></a>
                {{else}}
                <div class="flex gap-1 items-center text-gray-600">
                  <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                  <span>Demo Unavailable</span>
                </div>
                {{/if}}
                

                
              </div>
            </div>
          </div>
          {{/each}}
        </div>

        <!-- CONTACT SECTION -->
        {{>contact}}
      </main>

      <!-- FOOTER -->
      {{>footer}}
    </div>

    <script src="/swiper/swiper-bundle.min.js"></script>
    <script src="/assets/js/index.js"></script>
  </body>
</html>