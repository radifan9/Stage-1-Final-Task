                            <div class="flex items-center">
                                <img src="https://picsum.photos/seed/microsoft/40/40" alt="Microsoft" class="w-10 h-10 object-cover rounded-full border mr-3">
                                <div class="text-sm text-gray-900">Microsoft</div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            <div>Jun 2019 - Feb 2021</div>
                            <div class="text-xs text-gray-500">1 year 9 months</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-wrap gap-1">
                                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">C#</span>
                                <span class="px-2 py-1 text-xs bg-purple-100 text-purple-800 rounded-full">.NET Core</span>
                                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">Azure</span>
                                <span class="px-2 py-1 text-xs bg-orange-100 text-orange-800 rounded-full">SQL Server</span>
                                <span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">Git</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                            <button class="bg-teal-500 hover:bg-teal-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200" data-responsibilities='["Developed enterprise-level applications using .NET framework", "Implemented cloud solutions on Microsoft Azure platform", "Maintained legacy systems and migrated them to modern architectures", "Participated in code reviews and mentored junior developers"]'>
                                Details
                            </button>
                            <button class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                                Edit
                            </button>
                            <button class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                                Delete
                            </button>
                        </td>
                    </tr>
