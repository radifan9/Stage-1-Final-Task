                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center">
                                <img src="https://picsum.photos/seed/netflix/40/40" alt="Netflix" class="w-10 h-10 object-cover rounded-full border mr-3">
                                <div class="text-sm text-gray-900">Netflix</div>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                            <div>Aug 2017 - May 2019</div>
                            <div class="text-xs text-gray-500">1 year 10 months</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-wrap gap-1">
                                <span class="px-2 py-1 text-xs bg-yellow-100 text-yellow-800 rounded-full">JavaScript</span>
                                <span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded-full">React</span>
                                <span class="px-2 py-1 text-xs bg-purple-100 text-purple-800 rounded-full">Redux</span>
                                <span class="px-2 py-1 text-xs bg-pink-100 text-pink-800 rounded-full">SASS</span>
                                <span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">Webpack</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                            <button class="bg-teal-500 hover:bg-teal-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200" data-responsibilities='["Created responsive user interfaces for streaming platform", "Optimized web performance for millions of concurrent users", "Implemented A/B testing frameworks for feature rollouts", "Worked closely with UX designers to improve user experience"]'>
                                Details
                            </button>
                            <button class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                                Edit
                            </button>
                            <button class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                                Delete
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

        <div class="flex bg-gray-400">
          <a class="border border-gray-600 bg-transparent text-gray-700 px-4 py-2 rounded-t-lg hover:bg-gray-50">
