                        <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
                            <button class="bg-teal-500 hover:bg-teal-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200" data-responsibilities='["Built responsive web applications using React and modern JavaScript", "Developed RESTful APIs with Node.js and Express", "Implemented database optimization strategies for high-traffic applications", "Collaborated with design teams to create pixel-perfect user interfaces"]'>
                                Details
                            </button>
                            <button class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                                Edit
                            </button>
                            <button class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs transition-colors duration-200">
                                Delete
                            </button>
