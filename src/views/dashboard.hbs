<!DOCTYPE html>
<html lang="en">
  <head>
    {{>head}}
  </head>
  <body>
    <div class="flex flex-col">
      <!-- NAVBAR -->
      {{>navbar}}

      <main class="max-w-7xl px-4 mx-auto mt-24">
        
        {{#if message.success}}
        <p
          class="bg-green-100 border-l-4 border-green-500 text-green-700 px-4 py-3 rounded mb-4"
        >
          {{message.success}}
        </p>
      {{/if}}

        {{!-- TECH STACKS --}}
        <h2 class="text-2xl font-bold mb-4">Tech Stacks:</h2>
        {{>dashboard_techstacks}}

        {{!-- WORK EXPERIENCES --}}
        <h2 class="text-2xl font-bold mb-4">Work Experiences:</h2>
        {{>dashboard_experiences}}

        {{!-- PROJECTS --}}
        <h2 class="text-2xl font-bold mb-4">My Projects:</h2>
        {{!-- <div class="text-amber-600 bg-amber-100 px-4 py-2 rounded-md mb-4 inline-flex items-center">
          <span class="mr-2">⚠️</span>
          <span>Add & Delete functionality coming soon</span>
        </div> --}}
        {{>dashboard_projects}}
      
        
      </main>
      <!-- FOOTER -->
      {{>footer}}
    </div>

    {{!-- <script src="/swiper/swiper-bundle.min.js"></script>
    <script src="/assets/js/index.js"></script> --}}
    <script src="/assets/js/delete.js"></script>
  </body>
</html>