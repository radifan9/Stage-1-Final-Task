<html lang="en">
  <head>
    {{>head}}
  </head>
  <body class="min-h-screen py-8">
    <div class="max-w-2xl px-4 mx-auto mt-24 mb-24">
      {{!-- NAVBAR --}}
      {{>navbar}}

      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
          
          {{#if techStack}}
          Edit Tech Stack
          {{else}}
          Add New Tech Stack
          {{/if}}
          </h1>
        <p class="mt-2 text-gray-600">
          {{#if techStack}}
          Fill in the details to edit a technology in your stack.
          {{else}}
          Fill in the details to add a new technology to your stack.
          {{/if}}
        </p>
      </div>

      <!-- Form Container -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <form
          method="POST"
          {{#if techStack}}
          action="/dashboard/techstacks/{{techStack.id}}"
          {{else}}
          action="/dashboard/techstacks"
          {{/if}}
          
          enctype="multipart/form-data"
          class="p-6 space-y-6"
        >
          <!-- Title Field -->
          <div>
            <label
              for="title"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Title
              <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              placeholder="Enter tech stack title (e.g., React, Node.js, Python)"
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200"
              value="{{techStack.title}}"
            
            />
          </div>

          {{#if techStack}}
          <div>
            <label
              for="Old Image"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Old Image
              
            </label>
             <div
              class="inline-flex items-center justify-center p-4 rounded-2xl shadow-xs w-24 h-24 transition-all duration-300 hover:scale-105 hover:shadow-md"
            >
              <img
                class="w-full h-full object-contain"
                src="/assets/uploads/{{techStack.img}}"
                alt="{{techStack.title}}"
              />
            </div>

          </div>
          {{/if}}

          <!-- File Upload Field -->
          <div>
            <label
              for="logo"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Logo Image
              {{#unless techStack}}<span class="text-red-500">*</span>{{/unless}}
            </label>
            <input
              type="file"
              id="logo"
              name="img"
              accept="image/*"
              {{#unless techStack}}required{{/unless}}
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200"
            />
            {{#if techStack}}
            <input type="hidden" name="existingImage" value="{{techStack.img}}">
            {{/if}}
            {{#if techStack}}
            <p class="mt-1 text-xs text-gray-500">Leave empty to keep the current image</p>
            {{/if}}
          </div>

          <!-- Form Actions -->
          <div
            class="flex items-center justify-between pt-6 border-t border-gray-200"
          >

            <a
              href="/dashboard"
              class="inline-flex items-center bg-gray-500 hover:bg-gray-600 text-white px-6 py-2 rounded-md transition-colors duration-200"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <span class="ml-2">Back</span>
            </a>

            <div class="flex space-x-3">
              <button
                type="submit"
                class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-md border border-blue-600 transition-colors duration-200 flex items-center gap-2"
              >
                {{#if techStack}}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
                Edit Tech Stack
                {{else}}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
                Add Tech Stack
                {{/if}}
                
              </button>
            </div>
          </div>
        </form>
      </div>

      
    </div>
    {{>footer}}
  </body>
</html>